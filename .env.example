# =============================================================================
# data-pipeline-platform — environment variable reference
# Copy to .env and fill in values. Never commit .env to source control.
# =============================================================================

# ----- Environment -----
PIPELINE_ENV=dev                        # dev | staging | prod

# ----- Airflow -----
AIRFLOW__CORE__FERNET_KEY=              # generate: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
AIRFLOW__CORE__SQL_ALCHEMY_CONN=postgresql+psycopg2://airflow:airflow@postgres:5432/airflow
AIRFLOW__CELERY__RESULT_BACKEND=db+postgresql://airflow:airflow@postgres:5432/airflow
AIRFLOW__CELERY__BROKER_URL=redis://:@redis:6379/0
AIRFLOW_UID=50000

# ----- Spark -----
SPARK_MASTER_URL=spark://spark-master:7077
SPARK_SHUFFLE_PARTITIONS=200
SPARK_EXECUTOR_MEMORY=2g
SPARK_DRIVER_MEMORY=1g
SPARK_EXECUTOR_CORES=2

# ----- Storage Paths (local dev uses bind-mounts; prod uses s3a:// or hdfs://) -----
BRONZE_BASE_PATH=/data/bronze
SILVER_BASE_PATH=/data/silver
GOLD_BASE_PATH=/data/gold
INGESTION_LANDING_PATH=/data/landing

# ----- Source Systems -----
SFTP_HOST=
SFTP_PORT=22
SFTP_USER=
SFTP_PASSWORD=
SFTP_REMOTE_DIR=/exports

API_BASE_URL=
API_KEY=
API_SECRET=

DB_EXPORT_JDBC_URL=
DB_EXPORT_USER=
DB_EXPORT_PASSWORD=
DB_EXPORT_DRIVER=com.mysql.cj.jdbc.Driver

# ----- Notifications -----
ALERT_EMAIL=data-eng@company.com
SMTP_HOST=smtp.company.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=

# ----- Secret Backend (set to vault or ssm for non-local envs) -----
SECRET_BACKEND=env                      # env | vault | ssm
VAULT_ADDR=
VAULT_TOKEN=
AWS_REGION=us-east-1
AWS_SSM_PREFIX=/pipeline/prod
