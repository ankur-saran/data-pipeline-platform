# =============================================================================
# data-pipeline-platform — .gitignore
# =============================================================================

# ── Secrets — NEVER commit these ─────────────────────────────────────────────
.env
*.key
*.pem
*.p12
*.jks
secrets/
vault-token

# ── sbt / Scala ───────────────────────────────────────────────────────────────
spark-jobs/target/
spark-jobs/project/target/
spark-jobs/project/project/
.bsp/
.metals/
.scala-build/
*.class

# ── Python ────────────────────────────────────────────────────────────────────
__pycache__/
*.py[cod]
*.pyo
*.pyd
.Python
.venv/
venv/
env/
ENV/
*.egg-info/
dist/
build/
.eggs/
pip-wheel-metadata/
.pytest_cache/
.coverage
htmlcov/
.mypy_cache/
.ruff_cache/

# ── Airflow ────────────────────────────────────────────────────────────────────
airflow/logs/
airflow/plugins/__pycache__/
airflow/dags/__pycache__/
standalone_admin_password.txt
airflow.db
airflow.cfg
webserver_config.py

# ── Great Expectations ────────────────────────────────────────────────────────
data_quality/uncommitted/
.ge_store_backend_id

# ── Data / Pipeline output — local only, never in source control ──────────────
/data/
data/landing/
data/bronze/
data/silver/
data/gold/
data/metrics/
data/quality_audit/

# ── Docker ────────────────────────────────────────────────────────────────────
docker/volumes/

# ── Logs ──────────────────────────────────────────────────────────────────────
*.log
logs/
/var/log/pipeline/

# ── IDEs ──────────────────────────────────────────────────────────────────────
.idea/
.vscode/
*.iml
*.iws
*.ipr
.DS_Store
Thumbs.db

# ── OS ────────────────────────────────────────────────────────────────────────
.DS_Store
.AppleDouble
.LSOverride
desktop.ini
